DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /aray/afkacademy/

    # No reescribir archivos ni carpetas reales (api/, assets, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA: resto de rutas → index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Evita shell viejo cacheado 30 días (había que F5 tras cada cambio).
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Assets con hash en el nombre: cache largo.
    <FilesMatch "\.(?:js|css|png|jpe?g|webp|svg|woff2?|wav)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
