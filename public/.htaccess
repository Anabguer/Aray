DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /aray/

    # No reescribir archivos ni carpetas reales (api/, assets, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA: resto de rutas → index.html
    RewriteRule ^ index.html [L]
</IfModule>
